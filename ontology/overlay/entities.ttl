@prefix ceo:  <https://w3id.org/cryptoeco/ontology#> .
@prefix eco:  <https://w3id.org/cryptoeco/id/ecosystem/> .
@prefix cat:  <https://w3id.org/cryptoeco/vocab/category/> .
@prefix tech: <https://w3id.org/cryptoeco/id/technology/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Seed curation: domain-layer types and typed relations for well-known nodes.
# This is a starting point. Assert only what is true of the real-world entity
# today and record history in skos:historyNote. Leave relations that follow
# from raw links plus node types to rules/E*.rq rather than stating them here.
# Subjects are taxonomy IRIs (eco:<file-slug>); check.py fails on dangling ones.

###############################################################################
# Layer 1s
###############################################################################

eco:ethereum a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 1 .
eco:bitcoin a ceo:Layer1 ; ceo:caip2 "bip122:000000000019d6689c085ae165831e93" .
eco:solana a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:svm ;
    ceo:caip2 "solana:5eykt4UsFv8P8NJdTREpY1vzqKqZKvdp" .

eco:bnb-chain a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 56 .
eco:avalanche a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 43114 ;
    skos:editorialNote "Typed by its flagship primary network (C-Chain). Avalanche L1s (subnets) can be typed individually."@en .
eco:tron a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:evm .
eco:hedera a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 295 .
eco:near a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:wasm .
eco:sui a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:move-vm .
eco:aptos a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:move-vm .
eco:internet-computer a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:wasm .
eco:fantom a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 250 ;
    skos:historyNote "Succeeded by the Sonic chain in 2024-25. The node titled \"Sonic\" in this taxonomy is an unrelated DEX on the Internet Computer."@en .
eco:gnosis-chain a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 100 ;
    ceo:governedBy eco:gnosis .
eco:kaia a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 8217 .
eco:hyperliquid a ceo:Layer1 , ceo:Appchain ; ceo:hasCategory cat:Derivatives ;
    ceo:supportsExecutionEnvironment tech:evm .
eco:monad a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:evm .
eco:ton a ceo:Layer1 .
eco:cardano a ceo:Layer1 .
eco:tezos a ceo:Layer1 .
eco:algorand a ceo:Layer1 .
eco:stellar a ceo:Layer1 .
eco:xrp a ceo:Layer1 ; ceo:alias "XRP Ledger" .
eco:dogecoin a ceo:Layer1 .
eco:litecoin a ceo:Layer1 ; ceo:forkOf eco:bitcoin .
eco:bitcoin-cash a ceo:Layer1 ; ceo:forkOf eco:bitcoin .
eco:bitcoin-sv a ceo:Layer1 ; ceo:forkOf eco:bitcoin-cash .
eco:ethereum-classic a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 61 .
eco:zcash a ceo:Layer1 ; ceo:hasCategory cat:Privacy , cat:ZeroKnowledge ; ceo:forkOf eco:bitcoin .
eco:zclassic a ceo:Layer1 ; ceo:hasCategory cat:Privacy ; ceo:forkOf eco:zcash .
eco:monero a ceo:Layer1 ; ceo:hasCategory cat:Privacy .
eco:filecoin a ceo:Layer1 ; ceo:hasCategory cat:Storage ; ceo:developedBy eco:protocol-labs ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 314 .
eco:arweave a ceo:Layer1 ; ceo:hasCategory cat:Storage .
eco:avail a ceo:Layer1 ; ceo:hasCategory cat:DataAvailability ; ceo:builtWith tech:substrate .
eco:bittensor a ceo:Layer1 ; ceo:hasCategory cat:AI ; ceo:builtWith tech:substrate .
eco:heco a ceo:Layer1 ; ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 128 ;
    ceo:hasNativeAsset eco:huobi-token ;
    skos:historyNote "Huobi ECO Chain; largely inactive since 2023."@en .
eco:multiversx-elrond a ceo:Layer1 ; ceo:formerName "Elrond" .
eco:aeternity a ceo:Layer1 ;
    skos:editorialNote "Listed only under Ethereum in the source; AE launched as an ERC-20 before its own mainnet. The raw link is historical and gets no typed equivalent."@en .

# --- Cosmos family ------------------------------------------------------------

eco:cosmos-network a ceo:NetworkFamily ;
    skos:editorialNote "Umbrella over independently typed Cosmos SDK chains; the Cosmos Hub has its own node."@en .
eco:cosmos-hub a ceo:Layer1 ; ceo:memberOfFamily eco:cosmos-network ; ceo:builtWith tech:cosmos-sdk , eco:cometbft ;
    ceo:implementsStandard tech:ibc ; ceo:caip2 "cosmos:cosmoshub-4" ;
    skos:editorialNote "A root node in the source despite being the Cosmos Hub; memberOfFamily repairs that."@en .
eco:osmosis a ceo:Layer1 , ceo:Appchain ; ceo:hasCategory cat:DEX ; ceo:builtWith tech:cosmos-sdk ;
    ceo:supportsExecutionEnvironment eco:cosmwasm ; ceo:implementsStandard tech:ibc ; ceo:caip2 "cosmos:osmosis-1" .
eco:celestia a ceo:Layer1 ; ceo:hasCategory cat:DataAvailability ; ceo:builtWith tech:cosmos-sdk ;
    ceo:caip2 "cosmos:celestia" .
eco:dydx a ceo:Layer1 , ceo:Appchain ; ceo:hasCategory cat:Derivatives ; ceo:builtWith tech:cosmos-sdk ;
    ceo:caip2 "cosmos:dydx-mainnet-1" ;
    skos:historyNote "v3 ran on StarkEx as an Ethereum layer 2; v4 (2023) is a Cosmos appchain."@en .
eco:injective a ceo:Layer1 , ceo:Appchain ; ceo:hasCategory cat:DeFi ; ceo:builtWith tech:cosmos-sdk ;
    ceo:supportsExecutionEnvironment eco:cosmwasm ; ceo:caip2 "cosmos:injective-1" .
eco:stride-labs a ceo:Layer1 , ceo:Appchain ; ceo:hasCategory cat:LiquidStaking ; ceo:builtWith tech:cosmos-sdk ;
    ceo:primaryCategory cat:LiquidStaking ;
    skos:editorialNote "Has 16 raw parents: the chains whose assets it liquid-stakes. Typing it as a Cosmos appchain is what lets those links be read as service relationships rather than membership."@en .
eco:neutron a ceo:Layer1 ; ceo:supportsExecutionEnvironment eco:cosmwasm ; ceo:builtWith tech:cosmos-sdk .
eco:dymension a ceo:Layer1 ; ceo:builtWith tech:cosmos-sdk .
eco:axelar-network a ceo:Layer1 ; ceo:hasCategory cat:Interoperability ; ceo:builtWith tech:cosmos-sdk ;
    ceo:memberOfFamily eco:cosmos-network .
eco:akash-network a ceo:Layer1 ; ceo:hasCategory cat:Compute ; ceo:builtWith tech:cosmos-sdk .
eco:band-protocol a ceo:Layer1 ; ceo:hasCategory cat:Oracle ; ceo:builtWith tech:cosmos-sdk ;
    ceo:memberOfFamily eco:cosmos-network .
eco:cronos a ceo:Layer1 ; ceo:builtWith tech:cosmos-sdk ; ceo:supportsExecutionEnvironment tech:evm ;
    ceo:evmChainId 25 .

# --- Polkadot family ----------------------------------------------------------

eco:polkadot-network a ceo:NetworkFamily .
eco:kusama a ceo:Layer1 ; ceo:builtWith tech:substrate .
eco:moonbeam a ceo:Layer1 ; ceo:builtWith tech:substrate ; ceo:securedBy eco:polkadot-network ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 1284 .
eco:moonriver a ceo:Layer1 ; ceo:builtWith tech:substrate ; ceo:securedBy eco:kusama ;
    ceo:memberOfFamily eco:polkadot-network ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 1285 .

###############################################################################
# Layer 2s and sidechains
###############################################################################

eco:arbitrum a ceo:OptimisticRollup ; ceo:settlesOn eco:ethereum ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 42161 ; ceo:l2beatSlug "arbitrum" ;
    skos:editorialNote "Typed by its flagship network, Arbitrum One. Arbitrum Nova has its own node."@en .
eco:arbitrum-nova a ceo:Optimium ; ceo:settlesOn eco:ethereum ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 42170 .
eco:optimism a ceo:OptimisticRollup ; ceo:settlesOn eco:ethereum ; ceo:builtWith tech:op-stack ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 10 ; ceo:alias "OP Mainnet" ;
    ceo:l2beatSlug "optimism" .
eco:base a ceo:OptimisticRollup ; ceo:settlesOn eco:ethereum ; ceo:builtWith tech:op-stack ;
    ceo:developedBy eco:coinbase ; ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 8453 ;
    ceo:l2beatSlug "base" .
eco:zora a ceo:OptimisticRollup ; ceo:settlesOn eco:ethereum ; ceo:builtWith tech:op-stack ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 7777777 ;
    skos:editorialNote "Listed under Base and Optimism in the source because it is an OP Stack chain, not because it settles on them."@en .
eco:mode a ceo:OptimisticRollup ; ceo:settlesOn eco:ethereum ; ceo:builtWith tech:op-stack ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 34443 .
eco:blast a ceo:OptimisticRollup ; ceo:settlesOn eco:ethereum ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 81457 .
eco:mantle a ceo:Layer2 ; ceo:settlesOn eco:ethereum ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 5000 .
eco:celo a ceo:Layer2 ; ceo:settlesOn eco:ethereum ; ceo:builtWith tech:op-stack ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 42220 ;
    skos:historyNote "An independent Layer 1 until March 2025, when it migrated to an Ethereum Layer 2."@en .
eco:starknet a ceo:ZKRollup ; ceo:settlesOn eco:ethereum ;
    ceo:supportsExecutionEnvironment tech:cairo-vm ; ceo:l2beatSlug "starknet" .
eco:zksync a ceo:ZKRollup ; ceo:settlesOn eco:ethereum ; ceo:builtWith tech:zk-stack ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 324 ; ceo:alias "ZKsync Era" .
eco:scroll a ceo:ZKRollup ; ceo:settlesOn eco:ethereum ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 534352 .
eco:linea a ceo:ZKRollup ; ceo:settlesOn eco:ethereum ; ceo:developedBy eco:consensys ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 59144 .
eco:taiko a ceo:Rollup ; ceo:settlesOn eco:ethereum ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 167000 .
eco:polygon-zkevm a ceo:ZKRollup ; ceo:settlesOn eco:ethereum ;
    ceo:supportsExecutionEnvironment tech:evm ; ceo:evmChainId 1101 ;
    skos:historyNote "Polygon announced in 2025 that the network would be sunset."@en .
eco:eclipse a ceo:Layer2 ; ceo:settlesOn eco:ethereum ; ceo:supportsExecutionEnvironment tech:svm ;
    ceo:usesDataAvailability eco:celestia .

eco:xai a ceo:Layer2 ; ceo:settlesOn eco:arbitrum ; ceo:hasCategory cat:Gaming ;
    ceo:supportsExecutionEnvironment tech:evm ;
    skos:editorialNote "An Arbitrum Orbit chain settling on Arbitrum One; the reasoner classifies it as ceo:Layer3."@en .
eco:sanko a ceo:Layer2 ; ceo:supportsExecutionEnvironment tech:evm ;
    skos:editorialNote "settlesOn deliberately left to rule E01 (raw parent: Arbitrum), after which the reasoner classifies it as ceo:Layer3."@en .

eco:polygon a ceo:NetworkFamily ;
    skos:editorialNote "Covers Polygon PoS, Polygon zkEVM and CDK chains. The source files it under both EVM Compatible Layer 1s and Layer 2s; a family type resolves that. Polygon PoS (chain 137) has no node of its own."@en .

eco:lightning a ceo:StateChannelNetwork ; ceo:settlesOn eco:bitcoin ; ceo:hasCategory cat:Payments .
eco:liquid-network a ceo:Sidechain ; ceo:sidechainOf eco:bitcoin .

###############################################################################
# Protocols
###############################################################################

eco:uniswap a ceo:Protocol ; ceo:primaryCategory cat:DEX ; ceo:homeNetwork eco:ethereum .
eco:sushi-swap a ceo:Protocol ; ceo:primaryCategory cat:DEX ; ceo:homeNetwork eco:ethereum ; ceo:forkOf eco:uniswap .
eco:aave a ceo:Protocol ; ceo:primaryCategory cat:Lending ; ceo:homeNetwork eco:ethereum .
eco:maker a ceo:Protocol ; ceo:primaryCategory cat:Stablecoin ; ceo:hasCategory cat:Lending ;
    ceo:homeNetwork eco:ethereum ; ceo:alias "Sky" ;
    skos:historyNote "Rebranded as Sky in 2024."@en .
eco:lido a ceo:Protocol ; ceo:primaryCategory cat:LiquidStaking ; ceo:homeNetwork eco:ethereum ;
    skos:historyNote "Lido on Solana was sunset in 2023; the raw Solana link is historical."@en .
eco:eigenlayer a ceo:Protocol ; ceo:primaryCategory cat:Restaking ; ceo:homeNetwork eco:ethereum .
eco:chainlink a ceo:Protocol ; ceo:primaryCategory cat:Oracle ; ceo:homeNetwork eco:ethereum .
eco:pyth-network a ceo:Protocol ; ceo:primaryCategory cat:Oracle .
eco:the-graph a ceo:Protocol ; ceo:primaryCategory cat:Indexing .
eco:wormhole a ceo:Protocol ; ceo:primaryCategory cat:Messaging ; ceo:hasCategory cat:Bridge .
eco:layerzero a ceo:Protocol ; ceo:primaryCategory cat:Messaging .
eco:ethereum-name-service a ceo:Protocol ; ceo:primaryCategory cat:Identity ; ceo:homeNetwork eco:ethereum ;
    ceo:alias "ENS" .
eco:safe-ecosystem a ceo:Protocol ; ceo:primaryCategory cat:AccountAbstraction ; ceo:hasCategory cat:Wallet .
eco:helium a ceo:Protocol ; ceo:primaryCategory cat:DePIN ; ceo:homeNetwork eco:solana ;
    skos:historyNote "Ran its own Layer 1 until it migrated to Solana in April 2023."@en .
eco:farcaster a ceo:Protocol ; ceo:primaryCategory cat:Social ; ceo:homeNetwork eco:optimism .

###############################################################################
# Software and specifications
###############################################################################

eco:metamask a ceo:Wallet ; ceo:developedBy eco:consensys ; ceo:supportsExecutionEnvironment tech:evm .
eco:phantom a ceo:Wallet ;
    skos:editorialNote "Five raw parents (Solana, Ethereum, Base, Polygon, Bitcoin); rules type them as ceo:supportsNetwork."@en .
eco:hardhat a ceo:DeveloperTool ; ceo:developedBy eco:nomic-foundation ; ceo:supportsExecutionEnvironment tech:evm ;
    skos:editorialNote "An isolated root in the source; these typed links place it."@en .
eco:foundry a ceo:DeveloperTool ; ceo:supportsExecutionEnvironment tech:evm .
eco:truffle a ceo:DeveloperTool ; ceo:developedBy eco:consensys ; ceo:supportsExecutionEnvironment tech:evm ;
    skos:historyNote "Sunset by Consensys in 2023."@en .
eco:anchor-framework a ceo:DeveloperTool ; ceo:supportsExecutionEnvironment tech:svm .
eco:alloy a ceo:Library ; ceo:supportsExecutionEnvironment tech:evm .

eco:solidity a ceo:ProgrammingLanguage ; ceo:compilesTo tech:evm .
eco:vyper a ceo:ProgrammingLanguage ; ceo:compilesTo tech:evm .
eco:yul a ceo:ProgrammingLanguage ; ceo:compilesTo tech:evm .
eco:cosmwasm a ceo:ExecutionEnvironment .

eco:tendermint a ceo:ConsensusEngine ; ceo:alias "Tendermint Core" .
eco:cometbft a ceo:ConsensusEngine ; ceo:forkOf eco:tendermint .
eco:polygon-cdk a ceo:RollupFramework .
eco:arbitrum-orbit a ceo:RollupFramework .
eco:starkex-stack a ceo:RollupFramework ; ceo:alias "StarkEx" ;
    skos:editorialNote "Titled like a grouping, but StarkEx is a real product; its members (Immutable, ApeX) are built with it."@en .

###############################################################################
# Services and organizations
###############################################################################

eco:infura a ceo:Service ; ceo:operatedBy eco:consensys ; ceo:hasCategory cat:NodeInfrastructure .
eco:dune-analytics a ceo:Service ; ceo:hasCategory cat:Analytics .
eco:defillama a ceo:Service ; ceo:hasCategory cat:Analytics .
eco:code-423n4 a ceo:Service ; ceo:hasCategory cat:Security ; ceo:alias "Code4rena" .
eco:binance-exchange a ceo:CentralizedExchange .
eco:snapshot a ceo:Application ; ceo:hasCategory cat:Governance ; ceo:supportsExecutionEnvironment tech:evm .

eco:coinbase a ceo:Company ; ceo:hasCategory cat:CentralizedExchange .
eco:consensys a ceo:Company .
eco:alchemy a ceo:Company ; ceo:hasCategory cat:NodeInfrastructure .
eco:protocol-labs a ceo:Company .
eco:ledger a ceo:Company ; ceo:hasCategory cat:Wallet .
eco:circle a ceo:Company ; ceo:hasCategory cat:Stablecoin , cat:Payments .
eco:nethermind a ceo:Company .
eco:nomic-foundation a ceo:Foundation .
eco:flashbots a ceo:Organization ; ceo:hasCategory cat:MEV .
eco:bankless-dao a ceo:DAO ; ceo:hasCategory cat:Education .
eco:gnosis a ceo:DAO ; ceo:alias "GnosisDAO" .

eco:ipfs a ceo:PeerToPeerNetwork ; ceo:hasCategory cat:Storage ; ceo:developedBy eco:protocol-labs .

###############################################################################
# Assets
###############################################################################

eco:tether a ceo:Stablecoin ; ceo:alias "USDT" .
eco:0xbitcoin a ceo:Token .
eco:huobi-token a ceo:Token ; ceo:alias "HT" ; ceo:issuedOn eco:ethereum ;
    skos:editorialNote "Its raw children are mostly HECO applications listed under the token rather than the chain; they get no typed link from the token."@en .
