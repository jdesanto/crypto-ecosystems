@prefix ceo:  <https://w3id.org/cryptoeco/ontology#> .
@prefix eco:  <https://w3id.org/cryptoeco/id/ecosystem/> .
@prefix cat:  <https://w3id.org/cryptoeco/vocab/category/> .
@prefix tech: <https://w3id.org/cryptoeco/id/technology/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Curated typing of the taxonomy's grouping nodes: nodes that do not denote a
# real-world entity but group others. ceo:groupingCriterion says what they group
# by; rules/G*.rq turn membership into typed facts:
#   concept criterion      -> member ceo:hasCategory <concept>
#   execution environment  -> member ceo:supportsExecutionEnvironment <env>
#   other technology       -> member ceo:usesTechnology <tech>
#   OWL class              -> member ceo:proposedType <class>   (for review)
#   object property+anchor -> member <property> <anchor>        (G5, typed members; G6 proposes the domain type otherwise)
# Several criteria on one grouping are conjunctive.

# --- Category groupings -----------------------------------------------------

eco:wallet-category a ceo:CategoryGrouping ; ceo:groupingCriterion cat:Wallet .
eco:oracles-category a ceo:CategoryGrouping ; ceo:groupingCriterion cat:Oracle .
eco:bridges-interoperability-category a ceo:CategoryGrouping ; ceo:groupingCriterion cat:Interoperability .
eco:bridge-category a ceo:CategoryGrouping ; ceo:groupingCriterion cat:Bridge ;
    skos:editorialNote "Nested inside Bridges & Interoperability (Category); a SKOS broader link already expresses that."@en .
eco:games-category a ceo:CategoryGrouping ; ceo:groupingCriterion cat:Gaming .
eco:zero-knowledge-cryptography a ceo:CategoryGrouping ; ceo:groupingCriterion cat:ZeroKnowledge .

# --- Technology stacks ------------------------------------------------------

eco:ethereum-virtual-machine-stack a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:evm .
eco:solana-virtual-machine-stack   a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:svm .
eco:move-stack                     a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:move-vm .
eco:cosmos-network-stack           a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:cosmos-sdk .
eco:polkadot-network-stack         a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:substrate .

# --- Compatibility and architecture groupings --------------------------------
# All of these collapse into the defined classes ceo:EVMCompatibleNetwork /
# ceo:SVMNetwork (plus ceo:Layer1 / ceo:Layer2) once members are typed.

eco:evm-compatible-l1-and-l2 a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:evm ;
    skos:editorialNote "Near-duplicate of \"EVM Compatible Layer 1s, 2s, and Dapps\"; both are parents of EVM Compatible Layer 1s / 2s. Candidate for merging."@en .
eco:evm-compatible-layer-1s-2s-and-dapps a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:evm ;
    skos:editorialNote "Near-duplicate of \"EVM Compatible L1 and L2\". Candidate for merging."@en .
eco:evm-compatible-layer-1s a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:evm , ceo:Layer1 .
eco:evm-compatible-layer-2s a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:evm , ceo:Layer2 .
eco:evm-compatible-application a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:evm .
eco:evm-multichain-dapps a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:evm .
eco:evm-toolkit a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:evm , cat:DeveloperTooling .

eco:svm-layer-1-and-layer-2s a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:svm .
eco:svm-layer-1s a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:svm , ceo:Layer1 .
eco:svm-layer-2s a ceo:TechnologyGrouping ; ceo:groupingCriterion tech:svm , ceo:Layer2 .

# Relational groupings: members stand in <property> to <anchor>.
eco:ethereum-l2s a ceo:TechnologyGrouping ;
    ceo:groupingCriterion ceo:settlesOn ; ceo:groupingAnchor eco:ethereum ;
    skos:editorialNote "Also contains applications (e.g. ApeX Protocol), which the rule leaves alone once they are typed."@en .

eco:eigenlayer-avs a ceo:TechnologyGrouping ;
    ceo:groupingCriterion ceo:securedBy ; ceo:groupingAnchor eco:eigenlayer .

# --- Catch-alls ---------------------------------------------------------------

eco:general a ceo:CatchAllGrouping ;
    skos:editorialNote "Holds exchanges, wallets, data sites and oracles with no shared criterion. Candidate for dissolution."@en .
eco:multichain-infrastructure a ceo:CatchAllGrouping ;
    skos:editorialNote "Mixes infrastructure (Alchemy, LayerZero) with exchanges (Binance, Bybit) and category groupings."@en .
