@prefix ceo:     <https://w3id.org/cryptoeco/ontology#> .
@prefix cat:     <https://w3id.org/cryptoeco/vocab/category/> .
@prefix tech:    <https://w3id.org/cryptoeco/id/technology/> .
@prefix owl:     <http://www.w3.org/2002/07/owl#> .
@prefix rdf:     <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:    <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:     <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:    <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

###############################################################################
#  Crypto Ecosystems Ontology (CEO) — core module
#
#  Three layers, one IRI per taxonomy node:
#
#    1. Taxonomy layer   — mirrors data/ecosystems/**/*.toml exactly. Generated
#                          by ontology/scripts/toml_to_rdf.py, no judgement.
#    2. Domain layer     — what kind of real-world thing a node denotes, and the
#                          typed relations between those things. Curated.
#    3. Facets           — SKOS concept schemes (vocab/*.ttl) for functional
#                          categories and repository roles.
#
#  The bridge between layer 1 and 2 is ceo:rollsUpInto: the raw
#  ceo:subEcosystemOf link and every typed relation that the source taxonomy
#  would have expressed as a sub-ecosystem link are sub-properties of it.
#
#  Profile: OWL 2 DL. Checked with HermiT by ontology/scripts/check.py.
###############################################################################

<https://w3id.org/cryptoeco/ontology>
    a owl:Ontology ;
    dcterms:title "Crypto Ecosystems Ontology"@en ;
    dcterms:description """Class and property hierarchy that sits on top of the
Crypto Ecosystems taxonomy (data/ecosystems). The taxonomy says only that one
ecosystem is a sub-ecosystem of another; this ontology says what each node is
(a Layer 1, a rollup, a protocol, a wallet, a company, a category grouping...)
and what each link means (settles on, deployed on, member of family, ...)."""@en ;
    owl:versionInfo "0.1.0" ;
    rdfs:comment "The w3id.org namespace is a placeholder until it is registered; see ontology/README.md."@en .

# ---------------------------------------------------------------------------
# External terms used in OWL 2 DL positions (declared so DL tools accept them)
# ---------------------------------------------------------------------------

skos:Concept        a owl:Class .
skos:ConceptScheme  a owl:Class .
skos:inScheme       a owl:ObjectProperty .
skos:broader        a owl:ObjectProperty .
skos:narrower       a owl:ObjectProperty .
skos:hasTopConcept  a owl:ObjectProperty .
skos:topConceptOf   a owl:ObjectProperty .
skos:exactMatch     a owl:ObjectProperty .
skos:closeMatch     a owl:ObjectProperty .
skos:prefLabel      a owl:AnnotationProperty .
skos:altLabel       a owl:AnnotationProperty .
skos:hiddenLabel    a owl:AnnotationProperty .
skos:definition     a owl:AnnotationProperty .
skos:scopeNote      a owl:AnnotationProperty .
skos:example        a owl:AnnotationProperty .
skos:historyNote    a owl:AnnotationProperty .
skos:editorialNote  a owl:AnnotationProperty .
skos:notation       a owl:AnnotationProperty .
dcterms:title       a owl:AnnotationProperty .
dcterms:description a owl:AnnotationProperty .
dcterms:source      a owl:AnnotationProperty .

# Reference individuals used in class definitions below (defined in vocab/).
cat:DataAvailability    a owl:NamedIndividual , skos:Concept .
cat:Oracle              a owl:NamedIndividual , skos:Concept .
cat:Wallet              a owl:NamedIndividual , skos:Concept .
cat:CentralizedExchange a owl:NamedIndividual , skos:Concept .
cat:Stablecoin          a owl:NamedIndividual , skos:Concept .
tech:evm                a owl:NamedIndividual .
tech:svm                a owl:NamedIndividual .
tech:move-vm            a owl:NamedIndividual .

###############################################################################
#  1. TAXONOMY LAYER — classes
###############################################################################

ceo:Ecosystem
    a owl:Class ;
    rdfs:label "Ecosystem"@en ;
    rdfs:comment """A node of the source taxonomy: one TOML file under
data/ecosystems, identified by its title. Membership in this class says
nothing about what the node denotes; that is the job of ceo:CryptoEntity and
ceo:EcosystemGrouping."""@en ;
    skos:scopeNote "Every node gets this type from the converter. Curators add a second type from the domain layer."@en .

ceo:EcosystemGrouping
    a owl:Class ;
    rdfs:subClassOf ceo:Ecosystem ;
    rdfs:label "Ecosystem grouping"@en ;
    rdfs:comment """A taxonomy node that exists only to group other nodes and
does not denote one real-world entity, e.g. "Wallet (Category)",
"Ethereum Virtual Machine Stack", "EVM Compatible Layer 2s", "General"."""@en ;
    skos:scopeNote "Describe what a grouping groups by with ceo:groupingCriterion (and optionally ceo:groupingAnchor). Rules in rules/ then turn its membership links into typed facts."@en .

ceo:CategoryGrouping
    a owl:Class ;
    rdfs:subClassOf ceo:EcosystemGrouping ;
    rdfs:label "Category grouping"@en ;
    rdfs:comment "A grouping by functional category, e.g. \"Oracles (Category)\", \"Wallet (Category)\", \"Zero Knowledge Cryptography\"."@en .

ceo:TechnologyGrouping
    a owl:Class ;
    rdfs:subClassOf ceo:EcosystemGrouping ;
    rdfs:label "Technology grouping"@en ;
    rdfs:comment "A grouping by shared technology stack, compatibility or architectural role, e.g. \"Move Stack\", \"EVM Compatible Layer 1s\", \"Ethereum L2s\", \"SVM Layer 2s\"."@en .

ceo:CatchAllGrouping
    a owl:Class ;
    rdfs:subClassOf ceo:EcosystemGrouping ;
    rdfs:label "Catch-all grouping"@en ;
    rdfs:comment "A grouping with no single criterion, e.g. \"General\", \"Multichain Infrastructure\". Candidates for dissolution."@en .

ceo:Repository
    a owl:Class ;
    rdfs:label "Repository"@en ;
    rdfs:comment "A source code repository listed in a [[repo]] entry. IRI is the lower-cased repository URL."@en .

ceo:CodeHostAccount
    a owl:Class ;
    rdfs:label "Code host account"@en ;
    rdfs:comment "An organization or user account on a code host (GitHub, GitLab, ...) under which repositories are owned. Listed in github_organizations or derived from a repository URL."@en .

[] a owl:AllDisjointClasses ;
   owl:members ( ceo:Ecosystem ceo:Repository ceo:CodeHostAccount ) .

###############################################################################
#  2. DOMAIN LAYER — classes
###############################################################################

ceo:CryptoEntity
    a owl:Class ;
    rdfs:label "Crypto entity"@en ;
    rdfs:comment """A real-world thing denoted by a taxonomy node: a network,
protocol, piece of software, specification, service, organization or asset."""@en ;
    skos:scopeNote """Modelling rules. (1) Type a node by what it primarily
denotes today; record history with skos:historyNote. (2) When a node bundles an
organization and its product (e.g. "Uniswap" = protocol + Uniswap Labs), type it
as the product and link the organization with ceo:developedBy if it has its own
node. (3) When a chain brand covers several networks, type it by its flagship
network, unless it is mainly an umbrella over independently-typed member
networks, in which case use ceo:NetworkFamily."""@en ;
    owl:disjointWith ceo:EcosystemGrouping , ceo:Repository , ceo:CodeHostAccount .

[] a owl:AllDisjointClasses ;
   owl:members ( ceo:Network ceo:NetworkFamily ceo:Protocol ceo:Software
                 ceo:Specification ceo:Service ceo:Organization ceo:Asset ) .

# --- Networks ---------------------------------------------------------------

ceo:Network
    a owl:Class ;
    rdfs:subClassOf ceo:CryptoEntity ;
    rdfs:label "Network"@en ;
    rdfs:comment "A decentralized network run by independent nodes: a blockchain, a layer-2 system, or a ledger-less peer-to-peer network."@en .

ceo:Layer1
    a owl:Class ;
    rdfs:subClassOf ceo:Network ;
    rdfs:label "Layer 1"@en ;
    rdfs:comment "A blockchain that provides its own consensus and data availability and does not derive security from another chain's settlement."@en ;
    skos:example "Ethereum, Bitcoin, Solana, Cosmos Hub, Osmosis"@en .

ceo:Layer2
    a owl:Class ;
    rdfs:subClassOf ceo:Network ,
        [ a owl:Restriction ; owl:onProperty ceo:settlesOn ; owl:someValuesFrom ceo:Network ] ;
    rdfs:label "Layer 2"@en ;
    rdfs:comment "A network that settles on, and derives security from, another network."@en ;
    skos:example "Arbitrum, Base, Starknet, Lightning"@en .

ceo:Rollup
    a owl:Class ;
    rdfs:subClassOf ceo:Layer2 ;
    rdfs:label "Rollup"@en ;
    rdfs:comment "A layer 2 that publishes its transaction data to its settlement layer."@en .

ceo:OptimisticRollup
    a owl:Class ;
    rdfs:subClassOf ceo:Rollup ;
    rdfs:label "Optimistic rollup"@en ;
    rdfs:comment "A rollup whose state transitions are accepted unless challenged by a fraud proof."@en ;
    skos:example "Arbitrum, OP Mainnet, Base"@en .

ceo:ZKRollup
    a owl:Class ;
    rdfs:subClassOf ceo:Rollup ;
    rdfs:label "ZK rollup"@en ;
    rdfs:comment "A rollup whose state transitions are proven with validity (zero-knowledge) proofs."@en ;
    skos:example "Starknet, zkSync, Scroll, Linea"@en .

ceo:Validium
    a owl:Class ;
    rdfs:subClassOf ceo:Layer2 ;
    rdfs:label "Validium"@en ;
    rdfs:comment "A layer 2 using validity proofs with transaction data kept off the settlement layer."@en .

ceo:Optimium
    a owl:Class ;
    rdfs:subClassOf ceo:Layer2 ;
    rdfs:label "Optimium"@en ;
    rdfs:comment "A layer 2 using fraud proofs with transaction data kept off the settlement layer."@en .

ceo:StateChannelNetwork
    a owl:Class ;
    rdfs:subClassOf ceo:Layer2 ;
    rdfs:label "State channel network"@en ;
    rdfs:comment "A layer 2 made of off-chain channels that settle on the base layer."@en ;
    skos:example "Lightning"@en .

ceo:Layer3
    a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( ceo:Layer2
                             [ a owl:Restriction ; owl:onProperty ceo:settlesOn ; owl:someValuesFrom ceo:Layer2 ] )
    ] ;
    rdfs:label "Layer 3"@en ;
    rdfs:comment "Defined class: a layer 2 that settles on another layer 2. Inferred, never asserted."@en .

ceo:Sidechain
    a owl:Class ;
    rdfs:subClassOf ceo:Network ,
        [ a owl:Restriction ; owl:onProperty ceo:sidechainOf ; owl:someValuesFrom ceo:Network ] ;
    rdfs:label "Sidechain"@en ;
    rdfs:comment "A chain with its own consensus whose assets are pegged to a parent chain, without inheriting its security."@en ;
    skos:example "Liquid Network"@en .

ceo:PeerToPeerNetwork
    a owl:Class ;
    rdfs:subClassOf ceo:Network ;
    rdfs:label "Peer-to-peer network"@en ;
    rdfs:comment "A decentralized network that has no consensus ledger of its own."@en ;
    skos:example "IPFS"@en .

[] a owl:AllDisjointClasses ;
   owl:members ( ceo:Layer1 ceo:Layer2 ceo:Sidechain ceo:PeerToPeerNetwork ) .

[] a owl:AllDisjointClasses ;
   owl:members ( ceo:Rollup ceo:Validium ceo:Optimium ceo:StateChannelNetwork ) .

ceo:OptimisticRollup owl:disjointWith ceo:ZKRollup .

ceo:Appchain
    a owl:Class ;
    rdfs:subClassOf ceo:Network ;
    rdfs:label "Appchain"@en ;
    rdfs:comment "Facet: a network dedicated to one application or application domain. Combine with Layer1 or Layer2."@en ;
    skos:example "Osmosis, dYdX, Injective"@en .

ceo:Testnet
    a owl:Class ;
    rdfs:subClassOf ceo:Network ,
        [ a owl:Restriction ; owl:onProperty ceo:testnetOf ; owl:someValuesFrom ceo:Network ] ;
    rdfs:label "Testnet"@en ;
    rdfs:comment "Facet: a public test deployment of another network."@en .

ceo:NetworkFamily
    a owl:Class ;
    rdfs:subClassOf ceo:CryptoEntity ;
    rdfs:label "Network family"@en ;
    rdfs:comment "A brand-level family of interoperating or jointly governed networks that are typed individually."@en ;
    skos:example "Cosmos Network, Polkadot Network, Polygon"@en .

# --- Protocols, software, specifications, services -------------------------

ceo:Protocol
    a owl:Class ;
    rdfs:subClassOf ceo:CryptoEntity ;
    rdfs:label "Protocol"@en ;
    rdfs:comment "An on-chain system of smart contracts or modules deployed on one or more networks (a \"dapp\" back end)."@en ;
    skos:example "Uniswap, Aave, Chainlink, EigenLayer, Wormhole"@en .

ceo:Software
    a owl:Class ;
    rdfs:subClassOf ceo:CryptoEntity ;
    rdfs:label "Software"@en ;
    rdfs:comment "A specific off-chain codebase or product that people install, embed or run."@en .

ceo:Application
    a owl:Class ;
    rdfs:subClassOf ceo:Software ;
    rdfs:label "Application"@en ;
    rdfs:comment "End-user software."@en .

ceo:Wallet
    a owl:Class ;
    rdfs:subClassOf ceo:Application ,
        [ a owl:Restriction ; owl:onProperty ceo:hasCategory ; owl:hasValue cat:Wallet ] ;
    rdfs:label "Wallet"@en ;
    rdfs:comment "Software that manages keys and signs transactions for users."@en ;
    skos:example "MetaMask, Phantom"@en .

ceo:Explorer
    a owl:Class ;
    rdfs:subClassOf ceo:Application ;
    rdfs:label "Explorer"@en ;
    rdfs:comment "A block or transaction explorer."@en .

ceo:DeveloperTool
    a owl:Class ;
    rdfs:subClassOf ceo:Software ;
    rdfs:label "Developer tool"@en ;
    rdfs:comment "A development framework, test harness, compiler front end, IDE plugin or similar tool."@en ;
    skos:example "Hardhat, Foundry, Truffle, Anchor Framework"@en .

ceo:Library
    a owl:Class ;
    rdfs:subClassOf ceo:Software ;
    rdfs:label "Library"@en ;
    rdfs:comment "A reusable code library."@en .

ceo:SDK
    a owl:Class ;
    rdfs:subClassOf ceo:Library ;
    rdfs:label "SDK"@en ;
    rdfs:comment "A library published as the official way to integrate with a network or protocol."@en .

ceo:NodeClient
    a owl:Class ;
    rdfs:subClassOf ceo:Software ;
    rdfs:label "Node client"@en ;
    rdfs:comment "An implementation of a network's node software."@en .

ceo:ChainFramework
    a owl:Class ;
    rdfs:subClassOf ceo:Software ;
    rdfs:label "Chain framework"@en ;
    rdfs:comment "Software for building new chains."@en ;
    skos:example "Cosmos SDK, Substrate, Polygon CDK"@en .

ceo:RollupFramework
    a owl:Class ;
    rdfs:subClassOf ceo:ChainFramework ;
    rdfs:label "Rollup framework"@en ;
    rdfs:comment "A chain framework for building layer 2 or layer 3 networks."@en ;
    skos:example "OP Stack, Arbitrum Orbit, ZK Stack, StarkEx"@en .

ceo:ConsensusEngine
    a owl:Class ;
    rdfs:subClassOf ceo:Software ;
    rdfs:label "Consensus engine"@en ;
    rdfs:comment "A reusable consensus and networking layer for chains."@en ;
    skos:example "CometBFT, Tendermint Core"@en .

ceo:Specification
    a owl:Class ;
    rdfs:subClassOf ceo:CryptoEntity ;
    rdfs:label "Specification"@en ;
    rdfs:comment "A technology defined by a specification with (potentially) many implementations."@en .

ceo:ExecutionEnvironment
    a owl:Class ;
    rdfs:subClassOf ceo:Specification ;
    rdfs:label "Execution environment"@en ;
    rdfs:comment "A virtual machine or runtime that executes smart contracts or transactions."@en ;
    skos:example "EVM, SVM, Move VM, CosmWasm, Cairo VM"@en .

ceo:ProgrammingLanguage
    a owl:Class ;
    rdfs:subClassOf ceo:Specification ;
    rdfs:label "Programming language"@en ;
    skos:example "Solidity, Vyper, Yul, Move, Cairo"@en .

ceo:Standard
    a owl:Class ;
    rdfs:subClassOf ceo:Specification ;
    rdfs:label "Standard"@en ;
    rdfs:comment "An interface or protocol standard, e.g. ERC-20, ERC-4337, IBC."@en .

[] a owl:AllDisjointClasses ;
   owl:members ( ceo:ExecutionEnvironment ceo:ProgrammingLanguage ceo:Standard ) .

ceo:Service
    a owl:Class ;
    rdfs:subClassOf ceo:CryptoEntity ;
    rdfs:label "Service"@en ;
    rdfs:comment "A hosted, off-chain service operated by an organization: RPC and node APIs, data platforms, audit marketplaces, exchanges."@en ;
    skos:example "Infura, Dune Analytics, DefiLlama"@en .

ceo:CentralizedExchange
    a owl:Class ;
    rdfs:subClassOf ceo:Service ,
        [ a owl:Restriction ; owl:onProperty ceo:hasCategory ; owl:hasValue cat:CentralizedExchange ] ;
    rdfs:label "Centralized exchange"@en ;
    skos:example "Binance Exchange"@en .

# --- Organizations ----------------------------------------------------------

ceo:Organization
    a owl:Class ;
    rdfs:subClassOf ceo:CryptoEntity ;
    rdfs:label "Organization"@en ;
    rdfs:comment "A company, foundation, DAO, community or other group of people."@en .

ceo:Company     a owl:Class ; rdfs:subClassOf ceo:Organization ; rdfs:label "Company"@en ;
    skos:example "Coinbase, Consensys, Ledger"@en .
ceo:Foundation  a owl:Class ; rdfs:subClassOf ceo:Organization ; rdfs:label "Foundation"@en ;
    rdfs:comment "A non-profit that funds or stewards a network or technology."@en ;
    skos:example "Nomic Foundation"@en .
ceo:DAO         a owl:Class ; rdfs:subClassOf ceo:Organization ; rdfs:label "DAO"@en ;
    rdfs:comment "An organization governed through on-chain mechanisms."@en ;
    skos:example "Bankless DAO"@en .
ceo:Community   a owl:Class ; rdfs:subClassOf ceo:Organization ; rdfs:label "Community"@en ;
    rdfs:comment "An informal developer, education or user community."@en .

# --- Assets -----------------------------------------------------------------

ceo:Asset
    a owl:Class ;
    rdfs:subClassOf ceo:CryptoEntity ;
    rdfs:label "Asset"@en ;
    rdfs:comment "A transferable on-chain asset."@en .

ceo:Token
    a owl:Class ;
    rdfs:subClassOf ceo:Asset ,
        [ a owl:Restriction ; owl:onProperty ceo:issuedOn ; owl:someValuesFrom ceo:Network ] ;
    rdfs:label "Token"@en ;
    rdfs:comment "An asset issued by a contract or module on a host network."@en ;
    skos:example "0xBitcoin, Huobi Token"@en .

ceo:Stablecoin
    a owl:Class ;
    rdfs:subClassOf ceo:Token ,
        [ a owl:Restriction ; owl:onProperty ceo:hasCategory ; owl:hasValue cat:Stablecoin ] ;
    rdfs:label "Stablecoin"@en ;
    skos:example "Tether"@en .

ceo:NativeAsset
    a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( ceo:Asset
                             [ a owl:Restriction ; owl:onProperty ceo:nativeAssetOf ; owl:someValuesFrom ceo:Network ] )
    ] ;
    rdfs:label "Native asset"@en ;
    rdfs:comment "Defined class: an asset that is the native (gas/staking) asset of some network. Inferred from ceo:hasNativeAsset."@en .

# --- Defined role classes (inferred by a reasoner, never asserted) ----------

ceo:DataAvailabilityProvider
    a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( ceo:CryptoEntity
                             [ a owl:Restriction ; owl:onProperty ceo:hasCategory ; owl:hasValue cat:DataAvailability ] )
    ] ;
    rdfs:label "Data availability provider"@en ;
    rdfs:comment "Defined class: anything categorised as data availability."@en .

ceo:OracleProvider
    a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( ceo:CryptoEntity
                             [ a owl:Restriction ; owl:onProperty ceo:hasCategory ; owl:hasValue cat:Oracle ] )
    ] ;
    rdfs:label "Oracle provider"@en ;
    rdfs:comment "Defined class: anything categorised as an oracle, whether it is a protocol (Chainlink) or a chain (Band)."@en .

ceo:EVMCompatibleNetwork
    a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( ceo:Network
                             [ a owl:Restriction ; owl:onProperty ceo:supportsExecutionEnvironment ; owl:hasValue tech:evm ] )
    ] ;
    rdfs:label "EVM-compatible network"@en ;
    rdfs:comment "Defined class replacing the taxonomy's EVM Compatible Layer 1s / Layer 2s / L1 and L2 groupings."@en .

ceo:SVMNetwork
    a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( ceo:Network
                             [ a owl:Restriction ; owl:onProperty ceo:supportsExecutionEnvironment ; owl:hasValue tech:svm ] )
    ] ;
    rdfs:label "SVM network"@en ;
    rdfs:comment "Defined class replacing the taxonomy's SVM Layer 1s / Layer 2s groupings."@en .

ceo:MoveNetwork
    a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf ( ceo:Network
                             [ a owl:Restriction ; owl:onProperty ceo:supportsExecutionEnvironment ; owl:hasValue tech:move-vm ] )
    ] ;
    rdfs:label "Move network"@en ;
    rdfs:comment "Defined class replacing the network half of the taxonomy's Move Stack grouping."@en .

###############################################################################
#  3. TAXONOMY LAYER — properties (all produced by the converter)
###############################################################################

ceo:taxonomyRelation
    a owl:ObjectProperty ;
    rdfs:label "taxonomy relation"@en ;
    rdfs:comment "Abstract super-property of links asserted by the source taxonomy."@en .

ceo:hasSubEcosystem
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:taxonomyRelation ;
    owl:inverseOf ceo:subEcosystemOf ;
    rdfs:domain ceo:Ecosystem ;
    rdfs:range ceo:Ecosystem ;
    rdfs:label "has sub-ecosystem"@en ;
    rdfs:comment "Parent to child, exactly as listed in sub_ecosystems. Untyped: it can mean any of the domain-layer relations."@en .

ceo:subEcosystemOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:taxonomyRelation , ceo:rollsUpInto ;
    rdfs:label "sub-ecosystem of"@en ;
    rdfs:comment "Child to parent. The raw rollup link; see ceo:rollsUpInto."@en .

ceo:hasRepository
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:taxonomyRelation ;
    owl:inverseOf ceo:repositoryOf ;
    rdfs:domain ceo:Ecosystem ;
    rdfs:range ceo:Repository ;
    rdfs:label "has repository"@en .

ceo:repositoryOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:taxonomyRelation ;
    rdfs:label "repository of"@en .

ceo:hasCodeHostAccount
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:taxonomyRelation ;
    rdfs:domain ceo:Ecosystem ;
    rdfs:range ceo:CodeHostAccount ;
    rdfs:label "has code host account"@en ;
    rdfs:comment "From github_organizations. All repositories of the account count toward the ecosystem."@en .

ceo:ownedByAccount
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:taxonomyRelation ;
    rdfs:domain ceo:Repository ;
    rdfs:range ceo:CodeHostAccount ;
    rdfs:label "owned by account"@en ;
    rdfs:comment "Derived mechanically from the repository URL (github.com/<owner>/<repo>)."@en .

ceo:hasRole
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:taxonomyRelation ;
    rdfs:domain ceo:Repository ;
    rdfs:range skos:Concept ;
    rdfs:label "has role"@en ;
    rdfs:comment "What a repository is (library, docs, wallet, ...). A concept from vocab/repo-roles.ttl, resolved from the raw tag by label."@en .

ceo:url
    a owl:DatatypeProperty ;
    rdfs:range xsd:anyURI ;
    rdfs:label "URL"@en ;
    rdfs:comment "The URL exactly as written in the source (original casing)."@en .

ceo:rawTag
    a owl:DatatypeProperty ;
    rdfs:domain ceo:Repository ;
    rdfs:range xsd:string ;
    rdfs:label "raw tag"@en ;
    rdfs:comment "A tag string exactly as written in the source, kept for lossless round-tripping."@en .

ceo:markedMissing
    a owl:DatatypeProperty ;
    rdfs:domain ceo:Repository ;
    rdfs:range xsd:boolean ;
    rdfs:label "marked missing"@en ;
    rdfs:comment "The source flags the repository as no longer reachable (missing = true)."@en .

ceo:sourceFile
    a owl:DatatypeProperty ;
    rdfs:domain ceo:Ecosystem ;
    rdfs:range xsd:string ;
    rdfs:label "source file"@en ;
    rdfs:comment "Repository-relative path of the TOML file the node came from."@en .

###############################################################################
#  4. AGGREGATION — the bridge between raw and typed relations
###############################################################################

ceo:rollsUpInto
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:label "rolls up into"@en ;
    rdfs:comment """The subject's open-source activity is counted toward the
object when aggregating, which is the semantics of the source taxonomy's
parent/child link. The raw ceo:subEcosystemOf and every typed relation the
taxonomy would express as a sub-ecosystem link are sub-properties, so
aggregation queries work over raw data, curated data, or both."""@en ;
    skos:scopeNote "To aggregate under a narrower policy (say, only settlement and deployment), query the specific sub-properties instead."@en .

ceo:buildsOn
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:rollsUpInto ;
    rdfs:label "builds on"@en ;
    rdfs:comment "Generic typed rollup link: the subject's development targets the object. Use a sub-property when you know more."@en .

ceo:deployedOn
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:buildsOn ;
    rdfs:range ceo:Network ;
    rdfs:label "deployed on"@en ;
    rdfs:comment "The subject has contracts, modules or tokens live on the network."@en .

ceo:homeNetwork
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:deployedOn ;
    rdfs:label "home network"@en ;
    rdfs:comment "The network a multichain entity primarily belongs to. At most one (enforced by SHACL)."@en .

ceo:issuedOn
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:deployedOn ;
    rdfs:domain ceo:Token ;
    rdfs:label "issued on"@en .

ceo:connectsNetwork
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:deployedOn ;
    rdfs:label "connects network"@en ;
    rdfs:comment "A bridge or messaging protocol connects (and is deployed on) the network."@en .

ceo:supportsNetwork
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:buildsOn ;
    rdfs:range ceo:Network ;
    rdfs:label "supports network"@en ;
    rdfs:comment "Off-chain software or a service works with the network (wallets, tools, RPC providers)."@en .

ceo:clientOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:supportsNetwork ;
    rdfs:domain ceo:NodeClient ;
    rdfs:label "client of"@en .

ceo:securedBy
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:rollsUpInto , ceo:architecturalRelation ;
    rdfs:domain ceo:Network ;
    rdfs:label "secured by"@en ;
    rdfs:comment "The network derives its security from the object (settlement, shared security, restaking)."@en .

ceo:settlesOn
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:securedBy ;
    rdfs:domain ceo:Layer2 ;
    rdfs:range ceo:Network ;
    rdfs:label "settles on"@en ;
    rdfs:comment "Asserting it makes the subject a ceo:Layer2. Exactly one per layer 2 (SHACL)."@en .

ceo:sidechainOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:rollsUpInto , ceo:architecturalRelation ;
    rdfs:domain ceo:Sidechain ;
    rdfs:range ceo:Network ;
    rdfs:label "sidechain of"@en .

ceo:memberOfFamily
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:rollsUpInto ;
    rdfs:domain ceo:Network ;
    rdfs:range ceo:NetworkFamily ;
    rdfs:label "member of family"@en .

ceo:testnetOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:rollsUpInto ;
    rdfs:domain ceo:Testnet ;
    rdfs:range ceo:Network ;
    rdfs:label "testnet of"@en .

ceo:partOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:rollsUpInto ;
    rdfs:label "part of"@en ;
    rdfs:comment "Part-whole between entities, e.g. a product line within a larger project."@en .

###############################################################################
#  5. DOMAIN LAYER — other relation families
###############################################################################

# --- Architecture & technology ---------------------------------------------

ceo:architecturalRelation
    a owl:ObjectProperty ;
    rdfs:label "architectural relation"@en ;
    rdfs:comment "Abstract super-property of technical relations."@en .

ceo:usesDataAvailability
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:architecturalRelation ;
    rdfs:domain ceo:Network ;
    rdfs:range ceo:DataAvailabilityProvider ;
    rdfs:label "uses data availability"@en .

ceo:hasNativeAsset
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:architecturalRelation ;
    owl:inverseOf ceo:nativeAssetOf ;
    rdfs:domain ceo:Network ;
    rdfs:range ceo:Asset ;
    rdfs:label "has native asset"@en .

ceo:nativeAssetOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:architecturalRelation ;
    rdfs:label "native asset of"@en .

ceo:usesTechnology
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:architecturalRelation ;
    rdfs:range [ a owl:Class ; owl:unionOf ( ceo:Software ceo:Specification ) ] ;
    rdfs:label "uses technology"@en ;
    rdfs:comment "Generic: the subject is built with, runs, or targets the technology. Use a sub-property when you know more."@en .

ceo:supportsExecutionEnvironment
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:usesTechnology ;
    rdfs:range ceo:ExecutionEnvironment ;
    rdfs:label "supports execution environment"@en ;
    rdfs:comment "A network runs programs for the environment; software or a protocol targets it."@en .

ceo:builtWith
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:usesTechnology ;
    rdfs:range ceo:Software ;
    rdfs:label "built with"@en ;
    rdfs:comment "E.g. a chain built with a chain framework or consensus engine."@en .

ceo:implementsStandard
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:usesTechnology ;
    rdfs:range ceo:Standard ;
    rdfs:label "implements standard"@en .

ceo:compilesTo
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:architecturalRelation ;
    rdfs:domain ceo:ProgrammingLanguage ;
    rdfs:range ceo:ExecutionEnvironment ;
    rdfs:label "compiles to"@en .

ceo:supportsLanguage
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:usesTechnology ;
    rdfs:range ceo:ProgrammingLanguage ;
    owl:propertyChainAxiom ( ceo:supportsExecutionEnvironment [ owl:inverseOf ceo:compilesTo ] ) ;
    rdfs:label "supports language"@en ;
    rdfs:comment "Inferred by the property chain: a network that supports an execution environment supports every language that compiles to it."@en .

# --- Lineage ----------------------------------------------------------------

ceo:lineageRelation
    a owl:ObjectProperty ;
    rdfs:label "lineage relation"@en .

ceo:derivedFrom
    a owl:ObjectProperty , owl:TransitiveProperty ;
    rdfs:subPropertyOf ceo:lineageRelation ;
    rdfs:label "derived from"@en ;
    rdfs:comment "Transitive ancestry: Bitcoin SV derives from Bitcoin via Bitcoin Cash."@en .

ceo:forkOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:derivedFrom ;
    rdfs:label "fork of"@en ;
    rdfs:comment "Code or chain fork."@en .

ceo:successorOf
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:derivedFrom ;
    rdfs:label "successor of"@en ;
    rdfs:comment "A new entity that replaces an older one (migration or relaunch). For a pure rename, use ceo:formerName instead."@en .

# --- Organizational ---------------------------------------------------------

ceo:organizationalRelation
    a owl:ObjectProperty ;
    rdfs:label "organizational relation"@en .

ceo:developedBy
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:organizationalRelation ;
    owl:inverseOf ceo:develops ;
    rdfs:range ceo:Organization ;
    rdfs:label "developed by"@en .

ceo:develops
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:organizationalRelation ;
    rdfs:label "develops"@en .

ceo:operatedBy
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:organizationalRelation ;
    rdfs:domain ceo:Service ;
    rdfs:range ceo:Organization ;
    rdfs:label "operated by"@en .

ceo:governedBy
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:organizationalRelation ;
    owl:inverseOf ceo:governs ;
    rdfs:range ceo:Organization ;
    rdfs:label "governed by"@en .

ceo:governs
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:organizationalRelation ;
    rdfs:label "governs"@en .

ceo:stewardedBy
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:organizationalRelation ;
    rdfs:range ceo:Organization ;
    rdfs:label "stewarded by"@en ;
    rdfs:comment "Supported, funded or promoted by (e.g. a foundation), without implying control."@en .

# --- Classification (facets) -------------------------------------------------

ceo:hasCategory
    a owl:ObjectProperty ;
    rdfs:range skos:Concept ;
    rdfs:label "has category"@en ;
    rdfs:comment "Functional category from vocab/categories.ttl. Applies to entities and repositories."@en .

ceo:primaryCategory
    a owl:ObjectProperty ;
    rdfs:subPropertyOf ceo:hasCategory ;
    rdfs:label "primary category"@en ;
    rdfs:comment "At most one (enforced by SHACL)."@en .

###############################################################################
#  6. IDENTIFIERS AND ANNOTATIONS
###############################################################################

ceo:externalIdentifier
    a owl:DatatypeProperty ;
    rdfs:range xsd:string ;
    rdfs:label "external identifier"@en ;
    rdfs:comment "Abstract super-property of identifiers in other datasets. Link out rather than re-model what those datasets already maintain."@en .

ceo:caip2 a owl:DatatypeProperty ; rdfs:subPropertyOf ceo:externalIdentifier ;
    rdfs:label "CAIP-2 chain ID"@en ; rdfs:comment "Chain-agnostic chain identifier, e.g. eip155:1, cosmos:osmosis-1."@en .
ceo:coingeckoId a owl:DatatypeProperty ; rdfs:subPropertyOf ceo:externalIdentifier ; rdfs:label "CoinGecko ID"@en .
ceo:defillamaSlug a owl:DatatypeProperty ; rdfs:subPropertyOf ceo:externalIdentifier ; rdfs:label "DefiLlama slug"@en .
ceo:l2beatSlug a owl:DatatypeProperty ; rdfs:subPropertyOf ceo:externalIdentifier ; rdfs:label "L2BEAT slug"@en .

ceo:evmChainId
    a owl:DatatypeProperty ;
    rdfs:range xsd:integer ;
    rdfs:label "EVM chain ID"@en ;
    rdfs:comment "EIP-155 chain ID. rules/ derives ceo:caip2 \"eip155:<id>\" from it."@en .

ceo:wikidataItem   a owl:AnnotationProperty ; rdfs:label "Wikidata item"@en .
ceo:alias          a owl:AnnotationProperty ; rdfs:subPropertyOf skos:altLabel ; rdfs:label "alias"@en .
ceo:formerName     a owl:AnnotationProperty ; rdfs:subPropertyOf ceo:alias ; rdfs:label "former name"@en ;
    rdfs:comment "Replaces former names embedded in titles, e.g. \"Irys (prev Bundlr)\"."@en .

ceo:groupingCriterion
    a owl:AnnotationProperty ;
    rdfs:label "grouping criterion"@en ;
    rdfs:comment "What an ecosystem grouping groups by: a category concept, a technology individual, or a domain class. Multi-valued criteria are conjunctive."@en .

ceo:groupingAnchor
    a owl:AnnotationProperty ;
    rdfs:label "grouping anchor"@en ;
    rdfs:comment "The entity a relational grouping is about, e.g. Ethereum for \"Ethereum L2s\"."@en .

ceo:proposedType
    a owl:AnnotationProperty ;
    rdfs:label "proposed type"@en ;
    rdfs:comment "A type suggested by a derivation rule but not asserted. For curator review."@en .
