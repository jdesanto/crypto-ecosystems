PREFIX ceo:  <https://w3id.org/cryptoeco/ontology#>
PREFIX cat:  <https://w3id.org/cryptoeco/vocab/category/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# E07. Anything (except organizations, assets, specifications) listed under a chain framework
#      or consensus engine is built with it.
CONSTRUCT { ?child ceo:builtWith ?parent }
WHERE {
  VALUES ?pk { ceo:ChainFramework ceo:ConsensusEngine }
  ?parent a/rdfs:subClassOf* ?pk .
  ?parent ceo:hasSubEcosystem ?child .
  FILTER NOT EXISTS { ?child a/rdfs:subClassOf* ceo:EcosystemGrouping }
  FILTER NOT EXISTS { ?child a/rdfs:subClassOf* ceo:Organization }
  FILTER NOT EXISTS { ?child a/rdfs:subClassOf* ceo:Asset }
  FILTER NOT EXISTS { ?child a/rdfs:subClassOf* ceo:Specification }
}
