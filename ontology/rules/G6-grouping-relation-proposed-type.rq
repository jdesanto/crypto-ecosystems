PREFIX ceo:  <https://w3id.org/cryptoeco/ontology#>
PREFIX cat:  <https://w3id.org/cryptoeco/vocab/category/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# G6. Members of a relational grouping that are NOT typed within the property domain are
#     proposed the domain type (for review), e.g. untyped members of "Ethereum L2s" -> ceo:Layer2.
CONSTRUCT { ?member ceo:proposedType ?domain }
WHERE {
  ?grouping ceo:groupingCriterion ?p ; ceo:groupingAnchor ?anchor ; ceo:hasSubEcosystem ?member .
  ?p a owl:ObjectProperty ; rdfs:domain ?domain .
  FILTER NOT EXISTS { ?member a/rdfs:subClassOf* ?domain }
  FILTER NOT EXISTS { ?member a/rdfs:subClassOf* ceo:EcosystemGrouping }
}
