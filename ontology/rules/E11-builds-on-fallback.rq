PREFIX ceo:  <https://w3id.org/cryptoeco/ontology#>
PREFIX cat:  <https://w3id.org/cryptoeco/vocab/category/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# E11. Fallback: an UNTYPED node listed under a network, family or protocol builds on it.
#      The least-committal typed reading of a raw link; type the child to get a sharper one.
CONSTRUCT { ?child ceo:buildsOn ?parent }
WHERE {
  ?parent ceo:hasSubEcosystem ?child .
  VALUES ?pk { ceo:Network ceo:NetworkFamily ceo:Protocol }
  ?parent a/rdfs:subClassOf* ?pk .
  FILTER NOT EXISTS { ?child a/rdfs:subClassOf* ceo:CryptoEntity }
  FILTER NOT EXISTS { ?child a/rdfs:subClassOf* ceo:EcosystemGrouping }
}
