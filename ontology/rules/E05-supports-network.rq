PREFIX ceo:  <https://w3id.org/cryptoeco/ontology#>
PREFIX cat:  <https://w3id.org/cryptoeco/vocab/category/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# E05. Software or a service listed under a network supports it (wallets, tools, RPC providers).
CONSTRUCT { ?child ceo:supportsNetwork ?parent }
WHERE {
  ?parent ceo:hasSubEcosystem ?child .
  ?parent a/rdfs:subClassOf* ceo:Network .
  VALUES ?k { ceo:Software ceo:Service }
  ?child a/rdfs:subClassOf* ?k .
}
