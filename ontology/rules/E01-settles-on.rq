PREFIX ceo:  <https://w3id.org/cryptoeco/ontology#>
PREFIX cat:  <https://w3id.org/cryptoeco/vocab/category/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# E01. A layer 2 listed under a network settles on it, unless it already has a settlement
#      layer or the parent is a data-availability layer (which hosts rollups without settling them).
CONSTRUCT { ?child ceo:settlesOn ?parent }
WHERE {
  ?parent ceo:hasSubEcosystem ?child .
  ?parent a/rdfs:subClassOf* ceo:Network .
  ?child  a/rdfs:subClassOf* ceo:Layer2 .
  FILTER NOT EXISTS { ?child ceo:settlesOn ?any }
  FILTER NOT EXISTS { ?parent ceo:hasCategory cat:DataAvailability }
}
