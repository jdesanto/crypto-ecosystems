PREFIX ceo:  <https://w3id.org/cryptoeco/ontology#>
PREFIX cat:  <https://w3id.org/cryptoeco/vocab/category/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# G5. Relational grouping (criterion = object property, plus anchor): members typed within
#     the property domain get <property> <anchor>, e.g. "Ethereum L2s" -> ceo:settlesOn Ethereum.
CONSTRUCT { ?member ?p ?anchor }
WHERE {
  ?grouping ceo:groupingCriterion ?p ; ceo:groupingAnchor ?anchor ; ceo:hasSubEcosystem ?member .
  ?p a owl:ObjectProperty ; rdfs:domain ?domain .
  ?member a/rdfs:subClassOf* ?domain .
}
