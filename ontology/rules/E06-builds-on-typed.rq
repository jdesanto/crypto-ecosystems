PREFIX ceo:  <https://w3id.org/cryptoeco/ontology#>
PREFIX cat:  <https://w3id.org/cryptoeco/vocab/category/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# E06. Typed children with no more specific reading build on their parent:
#      organizations under a network, and non-network entities under a family or a protocol.
CONSTRUCT { ?child ceo:buildsOn ?parent }
WHERE {
  ?parent ceo:hasSubEcosystem ?child .
  {
    ?parent a/rdfs:subClassOf* ceo:Network .
    ?child  a/rdfs:subClassOf* ceo:Organization .
  } UNION {
    VALUES ?pk { ceo:NetworkFamily ceo:Protocol }
    VALUES ?ck { ceo:Protocol ceo:Software ceo:Service ceo:Organization }
    ?parent a/rdfs:subClassOf* ?pk .
    ?child  a/rdfs:subClassOf* ?ck .
  }
}
