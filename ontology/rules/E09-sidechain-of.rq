PREFIX ceo:  <https://w3id.org/cryptoeco/ontology#>
PREFIX cat:  <https://w3id.org/cryptoeco/vocab/category/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# E09. A sidechain listed under a network is a sidechain of it.
CONSTRUCT { ?child ceo:sidechainOf ?parent }
WHERE {
  ?parent ceo:hasSubEcosystem ?child .
  ?parent a/rdfs:subClassOf* ceo:Network .
  ?child  a/rdfs:subClassOf* ceo:Sidechain .
  FILTER NOT EXISTS { ?child ceo:sidechainOf ?any }
}
