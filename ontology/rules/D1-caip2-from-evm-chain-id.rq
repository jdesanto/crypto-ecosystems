PREFIX ceo:  <https://w3id.org/cryptoeco/ontology#>
PREFIX cat:  <https://w3id.org/cryptoeco/vocab/category/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# D1. CAIP-2 identifier from an EVM chain ID.
CONSTRUCT { ?n ceo:caip2 ?caip2 }
WHERE {
  ?n ceo:evmChainId ?id .
  FILTER NOT EXISTS { ?n ceo:caip2 ?existing }
  BIND(CONCAT("eip155:", STR(?id)) AS ?caip2)
}
