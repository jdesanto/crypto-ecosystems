PREFIX ceo:  <https://w3id.org/cryptoeco/ontology#>
PREFIX cat:  <https://w3id.org/cryptoeco/vocab/category/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
# E08. A network listed under an asset has that asset as its native asset (Huobi Token > HECO).
CONSTRUCT { ?child ceo:hasNativeAsset ?parent }
WHERE {
  ?parent ceo:hasSubEcosystem ?child .
  ?parent a/rdfs:subClassOf* ceo:Asset .
  ?child  a/rdfs:subClassOf* ceo:Network .
}
