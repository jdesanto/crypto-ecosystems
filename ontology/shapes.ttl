@prefix ceo:  <https://w3id.org/cryptoeco/ontology#> .
@prefix ceosh: <https://w3id.org/cryptoeco/shapes#> .
@prefix cat:  <https://w3id.org/cryptoeco/vocab/category/> .
@prefix role: <https://w3id.org/cryptoeco/vocab/repo-role/> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Closed-world checks that OWL (open world) cannot express: missing facts,
# cardinalities, and that typed links point at the right kind of node.
# Violations fail scripts/check.py; Warnings are reported as a curation queue.

# --- Taxonomy layer ---------------------------------------------------------

ceosh:EcosystemShape a sh:NodeShape ;
    sh:targetClass ceo:Ecosystem ;
    sh:property [ sh:path rdfs:label ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path ceo:sourceFile ; sh:minCount 1 ; sh:maxCount 1 ] .

ceosh:CategoryConceptShape a sh:NodeShape ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue cat:scheme ] .

ceosh:RoleConceptShape a sh:NodeShape ;
    sh:property [ sh:path skos:inScheme ; sh:hasValue role:scheme ] .

ceosh:RepositoryShape a sh:NodeShape ;
    sh:targetClass ceo:Repository ;
    sh:property [ sh:path ceo:url ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:anyURI ] ;
    sh:property [ sh:path ceo:hasRole ; sh:node ceosh:RoleConceptShape ] ;
    sh:property [ sh:path ceo:hasCategory ; sh:node ceosh:CategoryConceptShape ] .

# --- Groupings -------------------------------------------------------------------

ceosh:CriterionGroupingShape a sh:NodeShape ;
    sh:targetClass ceo:CategoryGrouping , ceo:TechnologyGrouping ;
    sh:property [
        sh:path ceo:groupingCriterion ; sh:minCount 1 ;
        sh:message "A category or technology grouping needs at least one ceo:groupingCriterion." ] .

# --- Domain layer -----------------------------------------------------------------

ceosh:CryptoEntityShape a sh:NodeShape ;
    sh:targetClass ceo:CryptoEntity ;
    sh:xone ( [ sh:class ceo:Network ] [ sh:class ceo:NetworkFamily ] [ sh:class ceo:Protocol ]
              [ sh:class ceo:Software ] [ sh:class ceo:Specification ] [ sh:class ceo:Service ]
              [ sh:class ceo:Organization ] [ sh:class ceo:Asset ] ) ;
    sh:message "Type an entity with exactly one top-level kind (Network, Protocol, Software, ...)." ;
    sh:property [ sh:path ceo:homeNetwork ; sh:maxCount 1 ; sh:class ceo:Network ] ;
    sh:property [ sh:path ceo:primaryCategory ; sh:maxCount 1 ] ;
    sh:property [ sh:path ceo:hasCategory ; sh:node ceosh:CategoryConceptShape ] ;
    sh:property [ sh:path ceo:deployedOn ; sh:class ceo:Network ] ;
    sh:property [ sh:path ceo:supportsNetwork ; sh:class ceo:Network ] ;
    sh:property [ sh:path ceo:supportsExecutionEnvironment ; sh:class ceo:ExecutionEnvironment ] ;
    sh:property [ sh:path ceo:builtWith ; sh:class ceo:Software ] ;
    sh:property [ sh:path ceo:developedBy ; sh:class ceo:Organization ] ;
    sh:property [ sh:path ceo:governedBy ; sh:class ceo:Organization ] .

ceosh:NetworkShape a sh:NodeShape ;
    sh:targetClass ceo:Network ;
    sh:property [ sh:path ceo:memberOfFamily ; sh:class ceo:NetworkFamily ] ;
    sh:property [ sh:path ceo:evmChainId ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path ceo:caip2 ; sh:maxCount 1 ;
                  sh:pattern "^[-a-z0-9]{3,8}:[-_a-zA-Z0-9]{1,32}$" ] .

ceosh:Layer2CountShape a sh:NodeShape ;
    sh:targetClass ceo:Layer2 ;
    sh:property [ sh:path ceo:settlesOn ; sh:minCount 1 ; sh:severity sh:Warning ;
                  sh:message "Layer 2 without ceo:settlesOn." ] .

ceosh:Layer2Shape a sh:NodeShape ;
    sh:targetClass ceo:Layer2 ;
    sh:property [ sh:path ceo:settlesOn ; sh:maxCount 1 ; sh:class ceo:Network ;
                  sh:message "A layer 2 settles on exactly one network." ] .

ceosh:SidechainShape a sh:NodeShape ;
    sh:targetClass ceo:Sidechain ;
    sh:property [ sh:path ceo:sidechainOf ; sh:minCount 1 ; sh:severity sh:Warning ] .

ceosh:TokenShape a sh:NodeShape ;
    sh:targetClass ceo:Token ;
    sh:property [ sh:path ceo:issuedOn ; sh:minCount 1 ; sh:severity sh:Warning ;
                  sh:message "Token without ceo:issuedOn." ] .

ceosh:ServiceShape a sh:NodeShape ;
    sh:targetClass ceo:Service ;
    sh:property [ sh:path ceo:operatedBy ; sh:class ceo:Organization ] .

ceosh:LanguageShape a sh:NodeShape ;
    sh:targetClass ceo:ProgrammingLanguage ;
    sh:property [ sh:path ceo:compilesTo ; sh:minCount 1 ; sh:class ceo:ExecutionEnvironment ;
                  sh:severity sh:Warning ] .
