@prefix ceo:  <https://w3id.org/cryptoeco/ontology#> .
@prefix tech: <https://w3id.org/cryptoeco/id/technology/> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

# Reference individuals for technologies that have NO node in data/ecosystems.
# Technologies that do have a node (Solidity, Vyper, Yul, CosmWasm, CometBFT,
# Polygon CDK, Arbitrum Orbit, ...) are typed on that node in overlay/, so each
# real-world thing has exactly one IRI. If a node appears later for one of these,
# link the two with owl:sameAs.

# --- Execution environments -------------------------------------------------

tech:evm a owl:NamedIndividual , ceo:ExecutionEnvironment ;
    rdfs:label "Ethereum Virtual Machine"@en ; skos:altLabel "EVM"@en .

tech:svm a owl:NamedIndividual , ceo:ExecutionEnvironment ;
    rdfs:label "Solana Virtual Machine"@en ; skos:altLabel "SVM"@en , "Sealevel"@en .

tech:move-vm a owl:NamedIndividual , ceo:ExecutionEnvironment ;
    rdfs:label "Move VM"@en ;
    skos:scopeNote "The Move VM family; Sui and Aptos run diverged variants."@en .

tech:cairo-vm a owl:NamedIndividual , ceo:ExecutionEnvironment ;
    rdfs:label "Cairo VM"@en .

tech:wasm a owl:NamedIndividual , ceo:ExecutionEnvironment ;
    rdfs:label "WebAssembly"@en ; skos:altLabel "Wasm"@en ;
    skos:scopeNote """Generic Wasm smart-contract runtimes (NEAR, Internet Computer). Keep
execution environments specific enough that sharing one implies contract
compatibility: ceo:supportsLanguage is inferred through them. Substrate contracts
and CosmWasm are therefore separate individuals."""@en .

tech:substrate-contracts a owl:NamedIndividual , ceo:ExecutionEnvironment ;
    rdfs:label "Substrate contracts (pallet-contracts)"@en ;
    skos:scopeNote "Wasm runtime of Substrate's contracts pallet; target of ink!."@en .

# --- Languages without their own node ----------------------------------------

tech:move a owl:NamedIndividual , ceo:ProgrammingLanguage ;
    rdfs:label "Move"@en ; ceo:compilesTo tech:move-vm .

tech:cairo a owl:NamedIndividual , ceo:ProgrammingLanguage ;
    rdfs:label "Cairo"@en ; ceo:compilesTo tech:cairo-vm .

tech:ink a owl:NamedIndividual , ceo:ProgrammingLanguage ;
    rdfs:label "ink!"@en ; ceo:compilesTo tech:substrate-contracts .

tech:rust-solana a owl:NamedIndividual , ceo:ProgrammingLanguage ;
    rdfs:label "Rust (Solana programs)"@en ; ceo:compilesTo tech:svm ;
    skos:scopeNote "Rust as a smart-contract language targeting SBF, not Rust in general."@en .

# --- Chain frameworks without their own node ---------------------------------

tech:cosmos-sdk a owl:NamedIndividual , ceo:ChainFramework ;
    rdfs:label "Cosmos SDK"@en .

tech:substrate a owl:NamedIndividual , ceo:ChainFramework ;
    rdfs:label "Substrate"@en ; skos:altLabel "Polkadot SDK"@en .

tech:op-stack a owl:NamedIndividual , ceo:RollupFramework ;
    rdfs:label "OP Stack"@en .

tech:zk-stack a owl:NamedIndividual , ceo:RollupFramework ;
    rdfs:label "ZK Stack"@en .

# --- Standards ---------------------------------------------------------------

tech:ibc a owl:NamedIndividual , ceo:Standard ;
    rdfs:label "Inter-Blockchain Communication"@en ; skos:altLabel "IBC"@en .

tech:erc-20 a owl:NamedIndividual , ceo:Standard ;
    rdfs:label "ERC-20"@en .

tech:erc-4337 a owl:NamedIndividual , ceo:Standard ;
    rdfs:label "ERC-4337"@en ; skos:altLabel "Account abstraction via entry point"@en .
