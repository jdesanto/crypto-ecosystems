cat:Infrastructure a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:topConceptOf cat:scheme ;
    skos:prefLabel "Infrastructure"@en ; skos:hiddenLabel "Infrastrcture"@en .

cat:Oracle a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:Infrastructure ;
