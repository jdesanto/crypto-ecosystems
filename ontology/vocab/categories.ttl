    skos:prefLabel "Decentralized compute"@en .

cat:NodeInfrastructure a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:Infrastructure ;
    skos:prefLabel "Node infrastructure"@en ; skos:altLabel "RPC"@en , "Node provider"@en , "Staking infrastructure"@en .

cat:Indexing a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:Infrastructure ;
