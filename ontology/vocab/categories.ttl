# --- Cryptography & privacy -------------------------------------------------

cat:Cryptography a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:topConceptOf cat:scheme ;
    skos:prefLabel "Cryptography"@en .

cat:ZeroKnowledge a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:Cryptography ;
    skos:prefLabel "Zero knowledge"@en ;
    skos:altLabel "ZKP"@en , "Zero-knowledge proofs"@en , "Zero Knowledge Cryptography"@en ;
    skos:hiddenLabel "Zero Knowlage Proofs"@en , "Chains and Pallets, ZKP"@en .

cat:FHE a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:Cryptography ;
    skos:prefLabel "Fully homomorphic encryption"@en ; skos:altLabel "FHE"@en .

cat:MPC a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:Cryptography ;
    skos:prefLabel "Multi-party computation"@en ; skos:altLabel "MPC"@en .

cat:HardwareAcceleration a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:Cryptography ;
    skos:prefLabel "Hardware acceleration"@en ; skos:altLabel "GPU"@en , "FPGA"@en ;
    skos:hiddenLabel "Hardware accleration"@en .

