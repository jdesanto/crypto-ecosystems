@prefix cat:  <https://w3id.org/cryptoeco/vocab/category/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

# Functional categories: WHAT an entity or repository does.
# Kept as SKOS (not OWL classes) because they are facets that change often and
# cut across kinds: Chainlink (a protocol) and Band (a chain) are both oracles.
#
# Labels double as the tag resolver used by scripts/toml_to_rdf.py:
# prefLabel / altLabel / hiddenLabel are matched case-insensitively, with '#',
# '-' and '_' treated as spaces. hiddenLabel holds misspellings and composite
# grant-category strings found in the raw tags.

cat:scheme
    a skos:ConceptScheme , owl:NamedIndividual ;
    skos:prefLabel "Crypto ecosystem functional categories"@en ;
    skos:hasTopConcept cat:DeFi , cat:Payments , cat:Infrastructure , cat:Cryptography ,
        cat:Privacy , cat:Consumer , cat:Governance , cat:Wallet , cat:CentralizedExchange ,
        cat:Custody , cat:Security , cat:Analytics , cat:DeveloperTooling , cat:Education ,
        cat:AI , cat:DePIN .

# --- DeFi -------------------------------------------------------------------

cat:DeFi a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:topConceptOf cat:scheme ;
    skos:prefLabel "DeFi"@en ; skos:altLabel "Decentralized finance"@en ;
    skos:hiddenLabel "Chains and Pallets, DeFi"@en , "ink Smart Contracts, DeFi"@en .

cat:DEX a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:DeFi ;
    skos:prefLabel "Decentralized exchange"@en ; skos:altLabel "DEX"@en , "AMM"@en .

cat:TradingAggregator a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:DeFi ;
    skos:prefLabel "Trading aggregator"@en ; skos:altLabel "DEX aggregator"@en .

cat:Lending a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:DeFi ;
    skos:prefLabel "Lending"@en ; skos:altLabel "Borrowing"@en .

cat:Derivatives a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:DeFi ;
    skos:prefLabel "Derivatives"@en ; skos:altLabel "Perpetuals"@en , "Options"@en .

cat:Stablecoin a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:DeFi ;
    skos:prefLabel "Stablecoin"@en ; skos:altLabel "Stablecoins"@en .

cat:LiquidStaking a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:DeFi ;
    skos:prefLabel "Liquid staking"@en .

cat:Restaking a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:DeFi ;
    skos:prefLabel "Restaking"@en .

cat:Yield a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:DeFi ;
    skos:prefLabel "Yield"@en ; skos:altLabel "Yield aggregator"@en , "Asset management"@en .

cat:RealWorldAssets a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:DeFi ;
    skos:prefLabel "Real-world assets"@en ; skos:altLabel "RWA"@en .

cat:PredictionMarket a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:broader cat:DeFi ;
    skos:prefLabel "Prediction market"@en .

# --- Payments ---------------------------------------------------------------

cat:Payments a skos:Concept , owl:NamedIndividual ; skos:inScheme cat:scheme ; skos:topConceptOf cat:scheme ;
    skos:prefLabel "Payments"@en ; skos:altLabel "Payment Processor"@en , "Payment Gateway"@en , "Streaming payments"@en .

